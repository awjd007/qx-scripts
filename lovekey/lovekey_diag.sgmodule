#!name=Lovekey 诊断（临时，测完请删）
#!desc=诊断模块：4 条脚本行用 4 种格式挂载信标（仅上报，不改写任何流量），另含 1 条重写规则作为「模块是否生效」对照
#!author=awjd007
#!homepage=https://github.com/awjd007/qx-scripts

[URL Rewrite]
# 对照项：拦截统计上报（无害）。若本模块生效，抓包中该请求将不再出现
^https:\/\/sea\.api\.lovekeyboard\.com\/dataCenter\/api\/event\/upload - reject

[Script]
# A：等号两侧无空格（此前正式模块使用的写法）
LkDiagA=type=http-request,pattern=^https:\/\/sea\.api\.lovekeyboard\.com\/v,requires-body=0,script-path=https://fastly.jsdelivr.net/gh/awjd007/qx-scripts@dacd82adc3f7aafec7262bcd0bea3e36c5d328dd/lovekey/lovekey_diag_a.js,script-update-interval=0
# B：等号两侧带空格（BoxJs / WarpPanel 等公开模块使用的写法）
LkDiagB = type=http-request, pattern=^https:\/\/sea\.api\.lovekeyboard\.com\/v, requires-body=false, timeout=30, script-path=https://fastly.jsdelivr.net/gh/awjd007/qx-scripts@dacd82adc3f7aafec7262bcd0bea3e36c5d328dd/lovekey/lovekey_diag_b.js, script-update-interval=0
# C：Surge 原生脚本行
http-request ^https:\/\/sea\.api\.lovekeyboard\.com\/v script-path=https://fastly.jsdelivr.net/gh/awjd007/qx-scripts@dacd82adc3f7aafec7262bcd0bea3e36c5d328dd/lovekey/lovekey_diag_c.js, requires-body=false, timeout=30, tag=LkDiagC
# D：响应阶段 + 带空格
LkDiagD = type=http-response, pattern=^https:\/\/sea\.api\.lovekeyboard\.com\/v, requires-body=true, max-size=262144, timeout=30, script-path=https://fastly.jsdelivr.net/gh/awjd007/qx-scripts@dacd82adc3f7aafec7262bcd0bea3e36c5d328dd/lovekey/lovekey_diag_d.js, script-update-interval=0

[MITM]
hostname = %APPEND% sea.api.lovekeyboard.com
