#!name=Lovekey 键盘修复版
#!desc=适配 Lovekey iOS；修复账号会员字段与聊天鉴权。脚本自包含（内联 CryptoJS，无 eval）
#!author=xiadasy / awjd007
#!homepage=https://github.com/awjd007/qx-scripts

[Script]
Lovekey-Chat=type=http-request,pattern=^https:\/\/sea\.api\.lovekeyboard\.com\/v1\/chat\/(?:keyboard-(?:ow|stream)-msg|stream_super_msg),requires-body=0,script-path=https://cdn.jsdelivr.net/gh/awjd007/qx-scripts@main/lovekey/lovekey_standalone.js,script-update-interval=0
Lovekey-Account=type=http-response,pattern=^https:\/\/sea\.api\.lovekeyboard\.com\/v2\/account,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/awjd007/qx-scripts@main/lovekey/lovekey_standalone.js,script-update-interval=0

[MITM]
hostname = %APPEND% sea.api.lovekeyboard.com
